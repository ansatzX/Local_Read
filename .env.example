# Local_Read 可选 API 配置；离线解析不需要此文件。
# 将所需配置填写到 ~/.config/local-read/.env；进程环境变量优先。
# 仓库/Skill 的 .env 不会自动加载。
# LOCAL_READ_CONFIG_DIR 可在启动前指定另一绝对配置目录。

# 用于 analyze 和显式 convert --visual-review auto|online。
# 配置密钥本身不会启用联网复核。
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
# 按服务商实际支持的模型填写。
VISION_MODEL=gpt-4o
# MB：单图分析文件大小，或单页复核发送图片的原始字节总量。
VISION_MAX_IMAGE_SIZE_MB=20

# 后备变量：OPENAI_API_KEY、OPENAI_BASE_URL、OPENAI_VISION_MODEL。
# 不要将密钥写入 SKILL.md、命令参数或提交到版本库。
# 本地模型独立管理：
#   ~/.local/bin/local-read models status
#   ~/.local/bin/local-read models prepare --source huggingface
# 模型默认在 ~/.cache/local-read/models/，跨项目复用。
# 路径覆盖 LOCAL_READ_MODEL_DIR、MINERU_TOOLS_CONFIG_JSON 应在启动前
# export 到进程环境，不依赖本 API 配置文件的加载时机。
